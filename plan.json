  "fuerzaEjercicios": {
    "fuerza_a": [
      {
        "name": "Sentadilla Goblet con Mancuerna",
        "meta": "3 series × 10 reps (bajada en 3s) · RPE 6–7 · 60s descanso",
        "desc": "Sostén una mancuerna vertical pegada al pecho. Pies al ancho de hombros con puntas ligeramente hacia afuera. Espalda neutra, desciende la cadera controladamente en 3 segundos cuidando que las rodillas sigan la línea de los pies. Activa cuádriceps y glúteos.",
        "link": "https://musclewiki.com/es-es/exercise/dumbbell-goblet-pulse-squat?model=f"
      },
      {
        "name": "Peso Muerto Rumano con Mancuernas",
        "meta": "3 series × 8–10 reps · RPE 7 · 60s descanso",
        "desc": "Bisagra pura de cadera empujando los glúteos hacia atrás con rodillas semiflexionadas (sin doblarlas en sentadilla). Baja las mancuernas pegadas a los muslos hasta sentir el estiramiento en los isquiotibiales. Mantén la espalda totalmente recta.",
        "link": "https://musclewiki.com/es-es/exercise/dumbbell-romanian-deadlift?model=f"
      },
      {
        "name": "Zancada Inversa ➔ Sentadilla Búlgara Unilateral",
        "meta": "3 series × 8 reps c/pierna · RPE 7 · 60s descanso",
        "desc": "Da un paso atrás flexionando ambas rodillas a 90°, manteniendo el torso erguido. Empieza siempre con la pierna más débil. Desde sem. 6 eleva el empeine trasero en silla o banco (búlgara) con alineación estricta de rodilla para evitar oscilación hacia adentro.",
        "link": "https://musclewiki.com/es-es/exercise/dumbbell-split-squat?model=f"
      },
      {
        "name": "Step-down Excéntrico Lento (Bajada de escalón)",
        "meta": "3 series × 8–10 reps c/pierna (bajada en 3–4s) · RPE 7 · 60s descanso",
        "desc": "CLAVE VASTO MEDIAL Y BAJADAS: Sobre un escalón o caja baja, apóyate en una pierna y desciende el talón opuesto hacia el suelo en 3–4 segundos lentos sin que la rodilla de apoyo colapse en valgo (hacia adentro). Simula el impacto excéntrico de los -642m de desnivel de Caracas.",
        "link": "https://musclewiki.com/es-es/exercise/bodyweight-step-down?model=f"
      },
      {
        "name": "Elevación de Talones de Pie con Mancuerna",
        "meta": "3 series × 12–15 reps · RPE 7 · 45s descanso",
        "desc": "De pie sosteniendo mancuerna. Subida explosiva en 1 segundo y bajada controlada y lenta en 3 segundos. Desarrolla la rigidez del tendón de Aquiles y la propulsión elástica.",
        "link": "https://musclewiki.com/es-es/exercise/standing-calf-raise?model=f"
      }
    ],
    "fuerza_b": [
      {
        "name": "Puente de Copenhague (o Glute Bridge con compresión)",
        "meta": "3 series × 20–30s por lado (o 12 reps con balón) · RPE 7 · 45s descanso",
        "desc": "BLINDAJE DIRECTO ADUCTOR DERECHO: En plancha lateral con la pierna superior apoyada sobre una silla/banco y la inferior suspendida (Copenhague), o tumbado boca arriba en puente de glúteos apretando fuertemente un cojín/balón entre las rodillas. Fortalece la cara interna del muslo para erradicar el calambre del km 30.",
        "link": "https://musclewiki.com/es-es/exercise/adductor-leg-raise-side-lying-isometric?model=f"
      },
      {
        "name": "Caminata Lateral con Banda Elástica",
        "meta": "3 series × 12 pasos por lado · RPE 6 · 45s descanso",
        "desc": "Coloca la banda elástica justo por encima de las rodillas (o en tobillos). En semi-sentadilla, da pasos laterales controlados manteniendo la tensión constante en el glúteo medio para estabilizar la pelvis y evitar el colapso medial.",
        "link": "https://musclewiki.com/es-es/exercise/side-walks-resisted?model=f"
      },
      {
        "name": "Plancha Frontal de Antebrazos",
        "meta": "3 series × 35–45 seg · RPE 7 · 45s descanso",
        "desc": "Apoyo en antebrazos y puntas de los pies. Contrae abdomen, glúteos y cuádriceps formando una línea recta desde la cabeza hasta los talones. Respira profundamente sin dejar caer la pelvis.",
        "link": "https://musclewiki.com/es-es/exercise/forearm-plank?model=f"
      },
      {
        "name": "Dead Bug / Bicho Muerto",
        "meta": "3 series × 10 reps por lado · RPE 6 · 45s descanso",
        "desc": "Boca arriba con brazos hacia el techo y rodillas a 90°. Presiona la espalda baja firmemente contra el suelo. Extiende simultáneamente el brazo derecho y la pierna izquierda sin despegar la zona lumbar.",
        "link": "https://musclewiki.com/es-es/exercise/dead-bug?model=f"
      },
      {
        "name": "Elevación de Talones Sentado / Rodilla Flexionada (Sóleo)",
        "meta": "3 series × 15 reps · RPE 7 · 45s descanso",
        "desc": "Sentado con rodillas a 90° y mancuernas apoyadas sobre los muslos cerca de la rodilla. Eleva los talones contrayendo el sóleo. Al tener la rodilla flexionada el gemelo se desactiva y el sóleo asume toda la carga de absorción de impacto.",
        "link": "https://musclewiki.com/es-es/exercise/plantar-flexions-seated-resisted?model=f"
      }
    ]
  }
